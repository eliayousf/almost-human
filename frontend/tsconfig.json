{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@game/*": [
        "../shared/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/@types/react/jsx-dev-runtime.d.ts"
      ],
      "convex/browser": [
        "./node_modules/convex/dist/esm-types/browser/index.d.ts"
      ],
      "convex/react": [
        "./node_modules/convex/dist/esm-types/react/index.d.ts"
      ],
      "convex/server": [
        "./node_modules/convex/dist/esm-types/server/index.d.ts"
      ],
      "@convex-dev/auth/react": [
        "./node_modules/@convex-dev/auth/dist/react/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "//": "Shared sources under ../shared and ../backend/client resolve their packages from THIS frontend's node_modules (mirrors vite resolve.dedupe); backend/ needs no install."
}
