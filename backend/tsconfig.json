{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["convex/**/*.ts", "tests/**/*.ts", "client/**/*.ts", "client/**/*.tsx", "playtest/**/*.ts", "playtest/**/*.tsx", "../shared/**/*.ts"]
}
