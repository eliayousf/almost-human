# Live mode only (`npm run dev:live`, `npm run build`). The repo owner injects
# the public Convex cloud URL at deploy time. Never put keys in VITE_* values.
VITE_CONVEX_URL=
# Local desktop test only: each normal tab becomes an independent test player.
VITE_INDEPENDENT_PLAYTEST_TABS=false
# strict 1v1 gate (build-time): repo owner sets true ONLY after the strict
# backend line is deployed and integration is permitted (backend deploys
# first), then rebuilds. Unset/false: strictPair is compiled out.
VITE_STRICT_PAIR=false
