{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix backend ci --ignore-scripts --no-audit --no-fund && npm --prefix frontend/expo ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node frontend/expo/scripts/vercel-build.mjs",
  "outputDirectory": "frontend/expo/dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
